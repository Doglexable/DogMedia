FROM nginx:stable-alpine
COPY homepage/nginx.conf /etc/nginx/conf.d/default.conf
COPY homepage/index.html homepage/styles.css homepage/player.js /usr/share/nginx/html/
COPY web/public/favicon.svg /usr/share/nginx/html/favicon.svg
COPY homepage/web-app-manifest-192x192.png /usr/share/nginx/html/web-app-manifest-192x192.png
EXPOSE 8040
