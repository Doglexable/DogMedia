FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY web/package.json ./web/
RUN npm ci --workspace=web --no-audit --no-fund

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./
COPY web ./web
# Bake the API URL into the bundle at build time
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
ARG VITE_ANDROID_APK_URL
ENV VITE_ANDROID_APK_URL=$VITE_ANDROID_APK_URL
RUN npm run build --workspace=web

FROM alpine:3.21
RUN apk add --no-cache nginx nginx-mod-http-headers-more
COPY web/nginx-main.conf /etc/nginx/nginx.conf
COPY web/nginx.conf /etc/nginx/conf.d/default.conf
COPY web/error.html /usr/share/nginx/html/error.html
COPY web/error.css /usr/share/nginx/html/error.css
COPY --from=builder /app/web/dist /usr/share/nginx/html
EXPOSE 8030
CMD ["nginx", "-g", "daemon off;"]
