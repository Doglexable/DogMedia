{
  "name": "private-file-stream",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web",
    "mobile"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=web",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "dev:mobile": "npm --workspace=mobile run dev --",
    "dev:desktop": "cargo run --manifest-path desktop/Cargo.toml",
    "worker": "npm run worker --workspace=server",
    "build": "npm run build --workspace=web",
    "build:desktop": "cargo build --release --manifest-path desktop/Cargo.toml",
    "package:desktop:deb": "desktop/packaging/deb/build-deb.sh",
    "package:desktop:rpm": "desktop/packaging/rpm/build-rpm.sh",
    "package:desktop:containers": "desktop/packaging/containers/build-packages.sh",
    "build:web:budget": "npm run build --workspace=web && node scripts/check-web-bundle.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "compress:thumbnails": "node scripts/compress-thumbnails.js",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=web && npm run lint --workspace=mobile",
    "test": "npm run test --workspace=server && npm run test --workspace=web && npm run test --workspace=mobile",
    "test:server": "npm run test --workspace=server",
    "test:web": "npm run test --workspace=web",
    "test:mobile": "npm run test --workspace=mobile",
    "test:desktop": "cargo test --manifest-path desktop/Cargo.toml"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "globals": "^17.12.0"
  }
}
