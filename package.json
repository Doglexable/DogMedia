{
  "name": "private-file-stream",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web",
    "mobile"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=web",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "dev:mobile": "npm --workspace=mobile run dev --",
    "dev:desktop": "cd desktop && dx serve --desktop --renderer native --bin dogmedia-desktop",
    "worker": "npm run worker --workspace=server",
    "build": "npm run build --workspace=web",
    "build:desktop": "cargo build --release --manifest-path desktop/Cargo.toml --bin dogmedia-desktop",
    "clean:desktop": "cargo clean --manifest-path desktop/Cargo.toml",
    "clean:desktop:packages": "desktop/scripts/clean-package-cache.sh",
    "check:desktop:native": "desktop/scripts/check-native-deps.sh",
    "check:desktop:packaging": "desktop/scripts/check-packaging.sh",
    "generate:desktop:icons": "desktop/scripts/generate-icons.sh",
    "package:desktop:deb": "desktop/packaging/deb/build-deb.sh && desktop/scripts/clean-package-cache.sh",
    "package:desktop:rpm": "desktop/packaging/rpm/build-rpm.sh && desktop/scripts/clean-package-cache.sh",
    "package:desktop:mac": "desktop/packaging/macos/build-mac.sh && desktop/scripts/clean-package-cache.sh",
    "package:desktop:win": "desktop/packaging/windows/build-win.sh && desktop/scripts/clean-package-cache.sh",
    "package:desktop:containers": "desktop/packaging/containers/build-packages.sh && desktop/scripts/clean-package-cache.sh",
    "package:desktop:cross": "desktop/packaging/containers/build-cross.sh && desktop/scripts/clean-package-cache.sh",
    "build:web:budget": "npm run build --workspace=web && node scripts/check-web-bundle.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "compress:thumbnails": "node scripts/compress-thumbnails.js",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=web && npm run lint --workspace=mobile",
    "test": "npm run test --workspace=server && npm run test --workspace=web && npm run test --workspace=mobile",
    "test:server": "npm run test --workspace=server",
    "test:web": "npm run test --workspace=web",
    "test:mobile": "npm run test --workspace=mobile",
    "test:desktop": "cargo test --manifest-path desktop/Cargo.toml",
    "test:desktop:native": "cargo test --manifest-path desktop/Cargo.toml --no-default-features --features native-ui --lib"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "globals": "^17.12.0"
  }
}
