# ─── Database ─────────────────────────────────────────────────────────────────
# Full Postgres connection string used by the server
DATABASE_URL=postgres://pfs:pfs_secret@localhost:5432/pfs

# Password used by the db service in compose (interpolated into DATABASE_URL)
PFS_DB_PASSWORD=pfs_secret

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Protected playback sessions (seconds) and the tier allowed to stream source files
PLAYBACK_SESSION_TTL_SECONDS=21600
MEDIA_ORIGINAL_MIN_TIER=100
MEDIA_SHARE_MIN_TIER=100
EXCLUSIVE_PLAYBACK_ENABLED=true
EXCLUSIVE_PLAYBACK_TIER_CUTOFF=100
EXCLUSIVE_PLAYBACK_LEASE_SECONDS=30

# Comma-separated origins allowed only when the web app calls the API cross-origin
PFS_ALLOWED_ORIGINS=

# Number of concurrent ffmpeg encoders in the worker service
ENCODING_CONCURRENCY=1
# Run resolution encoding only inside this local-time window (00:00-04:59 by default)
ENCODING_SCHEDULE_ENABLED=true
ENCODING_SCHEDULE_HOUR=0
ENCODING_SCHEDULE_END_HOUR=5
TZ=Asia/Jakarta

# Daily orphan media cleanup (disk files without matching media_assets rows)
ORPHAN_MEDIA_CLEANUP_ENABLED=true
ORPHAN_MEDIA_CLEANUP_INTERVAL_MS=86400000
ORPHAN_MEDIA_CLEANUP_GRACE_MS=86400000

# Remove abandoned chunk-upload sessions after 30 minutes without activity
INCOMPLETE_UPLOAD_CLEANUP_ENABLED=true
INCOMPLETE_UPLOAD_CLEANUP_INTERVAL_MS=300000
INCOMPLETE_UPLOAD_MAX_IDLE_MS=1800000

# Optional line-synced lyrics provider (LRCLIB)
LRCLIB_API_URL=https://lrclib.net
LRCLIB_TIMEOUT_MS=5000

# ─── Web (Vite – must be prefixed VITE_) ──────────────────────────────────────
# URL the browser uses to reach the API (empty = same origin / Vite proxy)
VITE_API_URL=
VITE_ANDROID_APK_URL=

# Public web origin used by the mobile app when creating share links.
# Usually the same origin as EXPO_PUBLIC_API_URL in production.
EXPO_PUBLIC_WEB_URL=
