# ─── Database ─────────────────────────────────────────────────────────────────
# Full Postgres connection string used by the server
DATABASE_URL=postgres://pfs:pfs_secret@localhost:5432/pfs

# Password used by the db service in compose (interpolated into DATABASE_URL)
PFS_DB_PASSWORD=pfs_secret

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Daily orphan media cleanup (disk files without matching media_assets rows)
ORPHAN_MEDIA_CLEANUP_ENABLED=true
ORPHAN_MEDIA_CLEANUP_INTERVAL_MS=86400000
ORPHAN_MEDIA_CLEANUP_GRACE_MS=86400000

# Optional line-synced lyrics provider
LYRICA_API_URL=https://wilooper-lyrica.hf.space
LYRICA_TIMEOUT_MS=5000

# ─── Web (Vite – must be prefixed VITE_) ──────────────────────────────────────
# URL the browser uses to reach the API (empty = same origin / Vite proxy)
VITE_API_URL=
