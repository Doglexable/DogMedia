FROM docker.io/library/rust:1.98.1-trixie

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        7zip \
        binutils \
        build-essential \
        ca-certificates \
        clang \
        cmake \
        cpio \
        file \
        git \
        libarchive-tools \
        libssl-dev \
        lld \
        llvm \
        nasm \
        nsis \
        pkg-config \
        python3 \
        python3-pefile \
        zip \
    && python3 -c 'import pefile' \
    && command -v llvm-lib \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add \
        aarch64-apple-darwin \
        x86_64-apple-darwin \
        x86_64-pc-windows-msvc \
    && cargo install --locked --version 0.23.4 cargo-zigbuild \
    && cargo install --locked --version 0.23.1 cargo-xwin

WORKDIR /work
CMD ["bash", "desktop/packaging/containers/run-cross.sh", "all"]
