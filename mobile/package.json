{
  "name": "pfs-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android",
    "build:android:apk": "npm run prebuild:android && cd android && ./gradlew assembleRelease",
    "export:android:apk": "npm run build:android:apk && node scripts/export-android-apk.js",
    "lint": "eslint .",
    "test": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~57.0.12",
    "expo-audio": "~57.0.3",
    "expo-build-properties": "~57.0.11",
    "expo-file-system": "~57.0.4",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "^57.0.1",
    "expo-video": "~57.0.2",
    "react": "19.2.3",
    "react-native": "^0.86.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.18.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "eslint": "^9.0.0",
    "vitest": "^4.0.0"
  }
}
